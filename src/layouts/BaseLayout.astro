---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'Petal Steel Art',
  description = 'Metal sculpture by Petal Steel Art.',
  ogType = 'website',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Petal Steel Art home">
        <img class="wordmark__logo" src="/media/identity/petal-steel-art-logo.svg" width="96" height="96" alt="" />
        <span>Petal Steel Art</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/work/">Work</a>
        <a href="/process/">Process</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <span>Petal Steel Art</span>
      <div class="site-footer__links">
        <a href="mailto:PetalSteelArt@gmail.com">PetalSteelArt@gmail.com</a>
        <a href="https://www.instagram.com/petal_steel_art/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://www.facebook.com/people/Petal-Steel-Art/61564266574964/" target="_blank" rel="noopener noreferrer">Facebook</a>
      </div>
    </footer>
  </body>
</html>
