---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { orderFeaturedArtworks } from '../utils/featured-artwork-order';

const featuredArtworks = orderFeaturedArtworks(
  (await getCollection('artworks')).filter(({ data }) => data.classification === 'featured'),
);
---

<BaseLayout description="Explore large-scale steel sculpture by Petal Steel Art, including A New Dance, big iron, Loot, and Big Dreams.">
  {featuredArtworks.map((artwork, artworkIndex) => {
    const supportingImages = artwork.data.images.filter((image) => image.homepageFeature);
    const titleId = `home-heading-${artwork.data.slug}`;
    return (
      <section class="home-feature" aria-labelledby={titleId}>
        <header class="home-feature__heading">
          <div>
            <p class="eyebrow">Featured Work</p>
            {artworkIndex === 0 ? (
              <h1 id={titleId}><a href={`/work/${artwork.data.slug}/`}>{artwork.data.title}</a></h1>
            ) : (
              <h2 id={titleId}><a href={`/work/${artwork.data.slug}/`}>{artwork.data.title}</a></h2>
            )}
          </div>
          <div class="home-feature__identification">
            {artwork.data.artist && <p class="home-feature__artist">{artwork.data.artist}</p>}
            <p>{[artwork.data.year, artwork.data.material, artwork.data.dimensions].filter(Boolean).join(' · ')}</p>
            <p class="home-feature__status">{[artwork.data.status, artwork.data.statusLocation].filter(Boolean).join(' · ')}</p>
            <a class="text-link" href={`/work/${artwork.data.slug}/`}>View the sculpture</a>
          </div>
        </header>

        <div class="home-feature__images" role="group" aria-label={`Photographs of ${artwork.data.title}`}>
          {artwork.data.heroImage && (
            <a class="home-photo-link home-photo-link--primary" href={`/work/${artwork.data.slug}/`}>
              <img
                src={artwork.data.heroImage.src}
                srcset={artwork.data.heroImage.fullWidth > artwork.data.heroImage.width
                  ? `${artwork.data.heroImage.src} ${artwork.data.heroImage.width}w, ${artwork.data.heroImage.fullSrc} ${artwork.data.heroImage.fullWidth}w`
                  : `${artwork.data.heroImage.src} ${artwork.data.heroImage.width}w`}
                sizes="(min-width: 72rem) 58vw, (min-width: 48rem) 62vw, 100vw"
                width={artwork.data.heroImage.width}
                height={artwork.data.heroImage.height}
                alt={artwork.data.heroImage.alt}
                fetchpriority={artworkIndex === 0 ? 'high' : 'auto'}
                loading={artworkIndex === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
          )}
          <div class="home-feature__support">
            {supportingImages.map((image) => (
              <a class="home-photo-link" href={`/work/${artwork.data.slug}/`}>
                <img
                  src={image.src}
                  srcset={image.fullWidth > image.width
                    ? `${image.src} ${image.width}w, ${image.fullSrc} ${image.fullWidth}w`
                    : `${image.src} ${image.width}w`}
                  sizes="(min-width: 72rem) 29vw, (min-width: 48rem) 30vw, 100vw"
                  width={image.width}
                  height={image.height}
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}
</BaseLayout>
