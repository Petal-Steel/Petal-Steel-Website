---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredArtwork = (await getCollection('artworks')).find(({ data }) => data.classification === 'featured');
const supportingImages = featuredArtwork?.data.images.filter((image) => image.homepageFeature) ?? [];
---

<BaseLayout>
  {featuredArtwork && (
    <section class="home-feature" aria-labelledby="home-heading">
      <header class="home-feature__heading">
        <div>
          <p class="eyebrow">Featured Work</p>
          <h1 id="home-heading"><a href={`/work/${featuredArtwork.data.slug}/`}>{featuredArtwork.data.title}</a></h1>
        </div>
        <div class="home-feature__identification">
          <p>{[featuredArtwork.data.year, featuredArtwork.data.material, featuredArtwork.data.dimensions].filter(Boolean).join(' · ')}</p>
          <p class="home-feature__status">{[featuredArtwork.data.status, featuredArtwork.data.statusLocation].filter(Boolean).join(' · ')}</p>
          <a class="text-link" href={`/work/${featuredArtwork.data.slug}/`}>View the sculpture</a>
        </div>
      </header>

      <div class="home-feature__images" role="group" aria-label={`Photographs of ${featuredArtwork.data.title}`}>
        {featuredArtwork.data.heroImage && (
          <a class="home-photo-link home-photo-link--primary" href={`/work/${featuredArtwork.data.slug}/`}>
            <img
              src={featuredArtwork.data.heroImage.src}
              srcset={`${featuredArtwork.data.heroImage.src} ${featuredArtwork.data.heroImage.width}w, ${featuredArtwork.data.heroImage.fullSrc} ${featuredArtwork.data.heroImage.fullWidth}w`}
              sizes="(min-width: 72rem) 58vw, (min-width: 48rem) 62vw, 100vw"
              width={featuredArtwork.data.heroImage.width}
              height={featuredArtwork.data.heroImage.height}
              alt={featuredArtwork.data.heroImage.alt}
              fetchpriority="high"
              decoding="async"
            />
          </a>
        )}
        <div class="home-feature__support">
          {supportingImages.map((image) => (
            <a class="home-photo-link" href={`/work/${featuredArtwork.data.slug}/`}>
              <img
                src={image.src}
                srcset={`${image.src} ${image.width}w, ${image.fullSrc} ${image.fullWidth}w`}
                sizes="(min-width: 72rem) 29vw, (min-width: 48rem) 30vw, 100vw"
                width={image.width}
                height={image.height}
                alt={image.alt}
                loading="lazy"
                decoding="async"
              />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
