---
import { getCollection } from 'astro:content';
import ArtworkFacts from '../../components/ArtworkFacts.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map((artwork) => ({ params: { slug: artwork.data.slug }, props: { artwork } }));
}

const { artwork } = Astro.props;
---

<BaseLayout title={`${artwork.data.title} | Petal Steel Art`}>
  <article class="artwork-page">
    {artwork.data.heroImage ? <img class="artwork-hero" src={artwork.data.heroImage.src} alt={artwork.data.heroImage.alt} /> : <div class="media-placeholder artwork-hero">Photography to be added</div>}
    <div class="artwork-page__details"><p class="eyebrow">{artwork.data.classification === 'featured' ? 'Featured Work' : 'Other Work'}</p><h1>{artwork.data.title}</h1><ArtworkFacts artwork={artwork.data} />{artwork.data.summary && <p>{artwork.data.summary}</p>}</div>
  </article>
</BaseLayout>
