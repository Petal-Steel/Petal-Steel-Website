---
import type { CollectionEntry } from 'astro:content';
import ArtworkFacts from './ArtworkFacts.astro';

interface Props { artwork: CollectionEntry<'artworks'>; }
const { artwork } = Astro.props;
---

<article class="artwork-card">
  {artwork.data.heroImage ? (
    <a href={`/work/${artwork.data.slug}/`} aria-label={`View ${artwork.data.title}`}>
      <img
        src={artwork.data.heroImage.src}
        srcset={`${artwork.data.heroImage.src} ${artwork.data.heroImage.width}w, ${artwork.data.heroImage.fullSrc} ${artwork.data.heroImage.fullWidth}w`}
        sizes="(min-width: 90.5rem) 43rem, (min-width: 48rem) calc((100vw - 4.5rem) / 2), (min-width: 40rem) calc((100vw - 6rem) / 2), calc(100vw - 2rem)"
        width={artwork.data.heroImage.width}
        height={artwork.data.heroImage.height}
        alt={artwork.data.heroImage.alt}
        loading="lazy"
        decoding="async"
      />
    </a>
  ) : (
    <div class="media-placeholder" aria-label="Artwork image to be added">Photography to be added</div>
  )}
  <div class="artwork-card__content">
    <h2><a href={`/work/${artwork.data.slug}/`}>{artwork.data.title}</a></h2>
    <ArtworkFacts artwork={artwork.data} />
  </div>
</article>
