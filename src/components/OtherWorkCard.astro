---
import type { CollectionEntry } from 'astro:content';

interface Props { artwork: CollectionEntry<'other-work'>; }
const { artwork } = Astro.props;
const image = artwork.data.images[0];
---

<article class="artwork-card">
  <a href={`/other-work/${artwork.data.slug}/`} aria-label={`View ${artwork.data.title} gallery`}>
    <img
      src={image.src}
      srcset={`${image.src} ${image.width}w, ${image.fullSrc} ${image.fullWidth}w`}
      sizes="(min-width: 90.5rem) 43rem, (min-width: 48rem) calc((100vw - 4.5rem) / 2), (min-width: 40rem) calc((100vw - 6rem) / 2), calc(100vw - 2rem)"
      width={image.width}
      height={image.height}
      alt={image.alt}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="artwork-card__content">
    <h2><a href={`/other-work/${artwork.data.slug}/`}>{artwork.data.title}</a></h2>
  </div>
</article>
