---
import type { CollectionEntry } from 'astro:content';

interface Props {
  image: NonNullable<CollectionEntry<'artworks'>['data']['heroImage']>;
  variant?: 'lead' | 'study';
  index?: number;
}

const { image, variant = 'study', index = 1 } = Astro.props;
---

<figure class:list={['artwork-photo', variant === 'lead' ? 'artwork-photo--lead' : 'artwork-photo--study', `artwork-photo--${index}`]}>
  <button
    class="photo-trigger"
    type="button"
    aria-label={`Enlarge photograph: ${image.alt}`}
    data-photo-open
    data-full={image.fullSrc}
    data-alt={image.alt}
    data-caption={image.caption ?? ''}
  >
    <img
      src={image.src}
      srcset={image.fullWidth > image.width
        ? `${image.src} ${image.width}w, ${image.fullSrc} ${image.fullWidth}w`
        : `${image.src} ${image.width}w`}
      sizes={variant === 'lead' ? '(min-width: 72rem) 57vw, (min-width: 48rem) 62vw, 100vw' : '(min-width: 72rem) 40vw, (min-width: 48rem) 48vw, 100vw'}
      width={image.width}
      height={image.height}
      alt={image.alt}
      loading={variant === 'lead' ? 'eager' : 'lazy'}
      fetchpriority={variant === 'lead' ? 'high' : 'auto'}
      decoding="async"
    />
    <span class="photo-enlarge-hint" aria-hidden="true">View larger</span>
  </button>
  {image.caption && <figcaption>{image.caption}</figcaption>}
</figure>
